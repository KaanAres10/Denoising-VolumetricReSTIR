# Build folder.
/build/

# Test output folder.
/tests/data/
/test-results/

# Media folders.
/media
/media_internal

# Packman folders.
/external/packman/
/tools/.packman/

# IDE folders.
/.vs/
/.vscode/

# User files.
/CMakeUserPresets.json

# File types.
*.user
*.suo
*.pyc
*.VC.db
*.VC.opendb
*.pyc
*slang-dump-*
*.mp4
*.tlog
*.bak
*.swp

# Local reference fork + its scene data (Denoising-VolumetricReSTIR): a separate repo with
# multi-GB .vbx / baked .bin assets. Kept locally only, never part of this repository.
/Denoising-VolumetricReSTIR/

/VolumetricReSTIRData/

# Source VDB sequences (JangaFX EmberGen, CC0). Multi-GB, kept locally only.
/FirePlumeVDB/
/DustShockwaveVDB/

# Manually vendored DLSS SDK (github.com/NVIDIA/DLSS v310.7.0) -- the only source of Ray
# Reconstruction, since packman ships Super Resolution only. ~106 MB of binaries, so not tracked.
# See Source/RenderPasses/DLSSPass/README.md for the exact fetch command.
/external/dlss-310/
# 310.9.1, same layout and fetch as dlss-310 with --branch v310.9.1. Ships RR2 (render preset F). ~111 MB.
/external/dlss-310.9.1/
# NRD v4, built from source (see Source/RenderPasses/NRDPass/README.md). ~10 MB of binaries.
/external/nrd-4/
/external/dlss-legacy-37/

# Local build logs.
/build_*.log
/build_*.errors.txt

# Rendered captures, references and sweep output. ~1 GB of EXR/PNG that a single `git add -A`
# would otherwise commit; the references in particular are regenerable from the reference tasks.
/shots/

# 1080p orbit captures and encodes: ~1.8 GB of PNG per run, regenerate with
# Source/RenderPasses/VolumetricReSTIR/Scripts/capture_orbit.py
/outputs/*
# ...except the analysis scripts. These compute every number in STATE.md, so the captures being
# regenerable only means anything while the code that scores them still exists. 180 KB of .py.
!/outputs/*.py

# Worktree of the falcor4-legacy branch (Falcor 4.x), for reproducing the pre-port OptiX/OIDN
# videos. Its own build tree and packman deps live here; never tracked by the v8 repo.
/legacy/

# [9.0] from upstream Falcor.
token.txt

customjob.yml
