# Stress scene (decorrelation study, spec V-B9): the bunny cloud lit by EIGHT small coloured point lights in and
# around it, no sky. With a luminance target a pixel's colour is the colour of the one light its sample chose;
# eight nearby lights of eight colours make that choice, and its clumping, the whole image. The light
# re-selection move is built for this. Positions around the cloud's centre (-0.9, 19.1, 0.9), radius ~20.
sceneBuilder.importScene(r'C:\research\Denoising-VolumetricReSTIR\VolumetricReSTIRData\default.obj')

def add_point(name, intensity, position):
    light = PointLight(name)
    light.intensity = intensity
    light.position = position
    sceneBuilder.addLight(light)

add_point('red', float3(300, 30, 30), float3(-8, 10, 8))
add_point('green', float3(30, 300, 30), float3(6, 12, -6))
add_point('blue', float3(40, 60, 400), float3(-2, 28, 4))
add_point('yellow', float3(250, 220, 20), float3(10, 25, 10))
add_point('magenta', float3(250, 20, 250), float3(-12, 22, -8))
add_point('cyan', float3(20, 250, 250), float3(3, 6, 12))
add_point('orange', float3(300, 140, 20), float3(-5, 35, -2))
add_point('violet', float3(150, 40, 300), float3(14, 15, 2))
