# Mutation-count scene (spec V-C7): 192 small coloured point lights in a jittered 8 x 6 x 4 grid through the bunny
# cloud, no sky, run with the density tripled (label bunnyswarm_d3). In a dense cloud a point sees only its few
# nearest lights, through transmittance the re-selection proposal does not model (it weighs a light by intensity /
# distance^2 x phase), so most re-selection proposals are rejected and a pixel keeps its light, and its colour, for
# many steps. Six strongly different hue families, shuffled so neighbouring lights differ: the colour of the light a
# sample chose is what reuse clumps (colour blotches), and only an accepted re-selection changes it.
import random

sceneBuilder.importScene(r'C:\research\Denoising-VolumetricReSTIR\VolumetricReSTIRData\default.obj')

HUES = [(1.0, 0.15, 0.1), (0.15, 1.0, 0.2), (0.15, 0.3, 1.0), (1.0, 0.85, 0.1), (1.0, 0.15, 0.9), (0.1, 0.9, 1.0)]
rng = random.Random(23)
colours = [HUES[k % 6] for k in range(192)]
rng.shuffle(colours)
k = 0
for ix in range(8):
    for iy in range(6):
        for iz in range(4):
            r, g, b = colours[k]
            light = PointLight('swarm%d' % k)
            light.intensity = float3(40 * r, 40 * g, 40 * b)
            light.position = float3(-18 + 34 * (ix + 0.5) / 8 + rng.uniform(-1, 1),
                                    0 + 38 * (iy + 0.5) / 6 + rng.uniform(-1, 1),
                                    -12 + 26 * (iz + 0.5) / 4 + rng.uniform(-1, 1))
            sceneBuilder.addLight(light)
            k += 1
