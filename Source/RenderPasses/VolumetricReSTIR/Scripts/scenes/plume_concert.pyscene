# Film-style shot (decorrelation study, spec V-B10): a concert -- the fire115 plume as stage smoke from a fog
# machine, crossed by SIX narrow coloured beams from a lighting truss above and behind it, fanned back toward the
# camera (backlit haze; run with a forward phase function, label plumeconcert_g0.6). ReSTIR's weak spots all at once:
# where beams overlap, a pixel shows the colour of the one beam its sample chose (colour blotches); a beam's sharp
# edge puts very different targets side by side; a view ray crosses several beams at different depths, so its
# target is multimodal in depth and a neighbour's copied depth lands in or out of a beam.
# Placed from the camera, since the plume fills its view: camera (1.977, 2.412, 2.242), view d = (-0.611, -0.192,
# -0.768), right r = (0.783, 0, -0.623); smoke centre C ~ camera + 1.3 d = (1.183, 2.162, 1.244). Truss T = C + 1.2 d +
# 1.6 up; spot k at T + (k - 2.5) 0.35 r, aimed at C - 0.4 d + (2.5 - k) 0.25 r - 0.3 up (the fan crosses mid-smoke).
sceneBuilder.importScene(r'C:\research\Denoising-VolumetricReSTIR\VolumetricReSTIRData\default.obj')

C = (1.183, 2.162, 1.244)
d = (-0.611, -0.192, -0.768)
r = (0.783, 0.0, -0.623)
up = (0.0, 1.0, 0.0)

def comb(*terms):
    return tuple(sum(w * v[i] for w, v in terms) for i in range(3))

colours = [(1.0, 0.1, 0.6), (0.1, 0.8, 1.0), (1.0, 0.6, 0.05), (0.2, 0.3, 1.0), (0.2, 1.0, 0.2), (1.0, 0.15, 0.1)]
for k, c in enumerate(colours):
    pos = comb((1, C), (1.2, d), (1.6, up), ((k - 2.5) * 0.35, r))
    aim = comb((1, C), (-0.4, d), ((2.5 - k) * 0.25, r), (-0.3, up))
    light = PointLight('beam%d' % k)
    light.intensity = float3(800 * c[0], 800 * c[1], 800 * c[2])
    light.position = float3(*pos)
    light.direction = float3(*(aim[i] - pos[i] for i in range(3)))
    light.openingAngle = 0.1
    light.penumbraAngle = 0.015
    sceneBuilder.addLight(light)
