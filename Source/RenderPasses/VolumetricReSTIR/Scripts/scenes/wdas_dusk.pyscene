# Film-style shot (spec V-C7; user, 2026-10-11: "more aesthetically pleasant scenes"): a STORM AT DUSK -- the Disney
# (WDAS) cumulus over the dawn hills (the loader's kiara_1_dawn, the low sun to one side as a warm key), lit from
# inside by five cool lightning flashes of falling strength (3e6 down to 6e5). The flashes sit where wdas_storm's first five do (the
# same draws), inside the cloud (x -217..198, y -68..214, z -298..213).
import random

sceneBuilder.importScene(r'C:\research\Denoising-VolumetricReSTIR\VolumetricReSTIRData\default.obj')

rng = random.Random(7)
for k, strength in enumerate((1.0, 0.55, 0.4, 0.3, 0.2)):
    light = PointLight('lightning%d' % k)
    i = 3.0e6 * strength
    light.intensity = float3(0.78 * i, 0.86 * i, 1.0 * i)
    light.position = float3(-10 + rng.uniform(-90, 90), 73 + rng.uniform(-50, 60), -43 + rng.uniform(-110, 110))
    sceneBuilder.addLight(light)
